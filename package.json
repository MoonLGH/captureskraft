{
  "name": "capturs-photobooth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capturs Photobooth kiosk and admin app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:webadmin": "npm --prefix webadmin run dev",
    "build": "tsc --noEmit && vite build",
    "build:webadmin": "npm --prefix webadmin run build",
    "preview:webadmin": "npm --prefix webadmin run preview",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis zip --publish never"
  },
  "dependencies": {
    "gif.js": "^0.2.0",
    "googleapis": "^190.0.0",
    "lucide-react": "^1.73.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "id.capturs.photobooth",
    "productName": "Capturs Photobooth",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tele/bot.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
